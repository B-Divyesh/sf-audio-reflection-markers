{
  "name": "audio-reflection-markers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/verify-dist.mjs && node scripts/check-budget.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:artifact": "node scripts/verify-dist.mjs",
    "test:update": "node scripts/check-update.mjs",
    "check:budget": "node scripts/check-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
